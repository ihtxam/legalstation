{
  "expo": {
    "name": "Cliavo",
    "slug": "cliavo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "cliavo",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cliavo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan and upload case documents with your camera.",
        "NSPhotoLibraryUsageDescription": "Attach photos of documents to your cases."
      }
    },
    "android": {
      "package": "com.cliavo.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cliavo to attach photos of documents.",
          "cameraPermission": "Allow Cliavo to scan documents with the camera."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://cliavo.com",
      "router": {
        "origin": false
      }
    }
  }
}
