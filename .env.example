# LexFlow / LegalStation — local & cloud development
# Copy to `.env` and fill in values. Never commit real secrets.
#
# Cloud Agents: set these in https://cursor.com/dashboard → Cloud Agents → Secrets
# (preferred). A generated `.env` is also created by `scripts/dev-setup.sh` for local runs.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Auth / session ---
# Random secret used to sign session cookies (required for login)
JWT_SECRET=change-me-to-a-long-random-string

# Manus OAuth (required for real sign-in flow)
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# --- Database (MySQL) ---
# docker compose default matches docker-compose.yml
DATABASE_URL=mysql://lexflow:lexflow@127.0.0.1:3306/lexflow

# --- Object storage / Forge (document upload, LLM, maps) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Email (Brevo) ---
BREVO_API_KEY=

# --- Payments (optional for core UI testing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Analytics (optional) ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
