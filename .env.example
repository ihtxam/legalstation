# Cliavo / LegalStation — local & cloud development
# Copy to `.env` and fill in values. Never commit real secrets.
#
# Cloud Agents: set these in https://cursor.com/dashboard → Cloud Agents → Secrets
# (preferred). A generated `.env` is also created by `scripts/dev-setup.sh` for local runs.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Deployment mode ---
# saas (default multi-tenant) | on_premise (single-tenant + offline license)
DEPLOYMENT_MODE=saas
SINGLE_TENANT=false
DATA_RESIDENCY=CH

# On-premise license (required when DEPLOYMENT_MODE=on_premise)
LICENSE_KEY=
LICENSE_SIGNING_SECRET=
LICENSE_GRACE_DAYS=14

# Encryption / key management (infra + app flags)
DB_ENCRYPTION_AT_REST=false
S3_SSE_MODE=AES256
S3_KMS_KEY_ID=
TENANT_DEK_ENABLED=false
TENANT_KEK=

# --- Auth / session ---
# Random secret used to sign session cookies (required for login)
JWT_SECRET=change-me-to-a-long-random-string

# Canonical public URL (emails, redirects)
APP_URL=https://cliavo.com
# Apex domain for firm subdomains (optional). Example: cliavo.com → firm.cliavo.com
APP_BASE_DOMAIN=
# One-time secret to create the first platform superadmin at /platform/login
SUPERADMIN_BOOTSTRAP_SECRET=

# Manus OAuth (optional; email/password is the primary SaaS login)
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Demo passwordless login + seed (dev / throwaway hosts only)
# Enables /api/demo/login and landing-page Demo login buttons
DEMO_AUTH_ENABLED=false
# Required in addition when NODE_ENV=production (never on real client sites)
DEMO_AUTH_ALLOW_PRODUCTION=false

# --- Database (MySQL) ---
# docker compose default matches docker-compose.yml
DATABASE_URL=mysql://cliavo:cliavo@127.0.0.1:3306/cliavo

# --- Object storage / Forge (document upload, LLM, maps) ---
# When unset, uploads fall back to local disk (LOCAL_STORAGE_DIR, default ./data/storage)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
LOCAL_STORAGE_DIR=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Email (Brevo) ---
BREVO_API_KEY=
# Verified sender in the Brevo account (required for delivery in production)
EMAIL_FROM=
EMAIL_FROM_NAME=Cliavo

# --- Payments (optional for core UI testing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_ENVIRONMENT=test
ADYEN_HMAC_KEY=

# --- Scheduled jobs (payment plan invoice generation) ---
# POST /api/scheduled/payment-plan-invoices with header x-scheduled-job-secret
SCHEDULED_JOB_SECRET=
SCHEDULED_JOB_USER_ID=1
# Also: POST /api/scheduled/calendar-sync (two-way Google / Outlook / iCloud)

# --- Calendar integrations (per-user two-way sync) ---
# Google Cloud OAuth client (Calendar API enabled); redirect:
#   {APP_URL}/api/oauth/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Microsoft Entra app (Calendars.ReadWrite + offline_access); redirect:
#   {APP_URL}/api/oauth/calendar/microsoft/callback
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common
# iCloud uses CalDAV + Apple app-specific password (no OAuth env vars)

# --- Analytics (optional) ---
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
