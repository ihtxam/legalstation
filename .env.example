# ─── LexFlow environment ─────────────────────────────────────────────────────
# Copy to .env for local/cloud testing, or .env.production for Hetzner.

# App
NODE_ENV=production
PORT=3000
DEPLOYMENT_MODE=saas
VITE_APP_ID=lexflow
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public URL (used by OAuth redirects / Stripe callbacks)
PUBLIC_APP_URL=http://localhost:3000

# Database (compose overrides host to `db`)
MYSQL_ROOT_PASSWORD=lexflow_root
MYSQL_DATABASE=lexflow
MYSQL_USER=lexflow
MYSQL_PASSWORD=lexflow
DATABASE_URL=mysql://lexflow:lexflow@db:3306/lexflow

# Auth — Manus OAuth (optional when ENABLE_DEV_LOGIN=true)
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
ENABLE_DEV_LOGIN=true

# Storage: forge | s3 | local
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=lexflow
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/lexflow

# Manus Forge (optional alternative to S3)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Email / payments (optional for smoke testing)
BREVO_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Analytics (optional; baked into client at build)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ─── Hetzner production extras (.env.production) ─────────────────────────────
# DOMAIN=legal.example.com
# ACME_EMAIL=ops@example.com
# ENABLE_DEV_LOGIN=false
# S3_PUBLIC_URL=https://legal.example.com/files
